# Oracle 26ai 연결 설정 — 이 파일은 "예시"(커밋 OK). 실제 값은 .env 에 넣으세요(gitignore됨).
# python-oracledb thin 모드 + Autonomous DB mTLS(wallet) 기준.

ORACLE_USER=ADMIN
ORACLE_PASSWORD=          # ← DB 만들 때 정한 ADMIN 비밀번호
ORACLE_DSN=dilab_high     # tnsnames.ora 의 서비스명 (PoC 기본: _high)
ORACLE_WALLET_DIR=./secrets/wallet
ORACLE_WALLET_PASSWORD=   # ← Wallet 다운로드 때 정한 비밀번호
