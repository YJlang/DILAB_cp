# ==========================================================================
# 렌더링
# ==========================================================================
def run(par, text, *, size, bold=False, color=INK, space_before=0, space_after=0):
    par.space_before = Pt(space_before)
    par.space_after = Pt(space_after)
    r = par.add_run()
    r.text = text
    f = r.font
    f.name = FONT
    f.size = Pt(size)
    f.bold = bold
    f.color.rgb = color
    # 한글이 라틴 글꼴로 떨어지지 않도록 eastAsia 를 명시한다
    rPr = r._r.get_or_add_rPr()
    from pptx.oxml.ns import qn
    ea = rPr.find(qn("a:ea"))
    if ea is None:
        ea = rPr.makeelement(qn("a:ea"), {})
        rPr.append(ea)
    ea.set("typeface", FONT)
    return r


def textbox(slide, l, t, w, h):
    tb = slide.shapes.add_textbox(inch(l), inch(t), inch(w), inch(h))
    tf = tb.text_frame
    tf.word_wrap = True
    tf.margin_left = tf.margin_right = 0
    tf.margin_top = tf.margin_bottom = 0
    return tb, tf


def build():
    prs = Presentation(str(TEMPLATE))

    # 템플릿 slide2 에서 장식 도형만 떠 온다 (배경/파란사각형/회색바/페이지번호)
    src = prs.slides[1]
    deco = [sh for sh in src.shapes if not sh.has_text_frame or not sh.text_frame.text.strip()
            or sh.text_frame.text.strip() == "2"]
    deco_xml = [deepcopy(sh._element) for sh in deco]
    blank_layout = src.slide_layout

    # 표지(slide1)만 남기고 나머지 제거
    xml_slides = prs.slides._sldIdLst
    for sld in list(xml_slides)[1:]:
        rId = sld.get("{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id")
        prs.part.drop_rel(rId)
        xml_slides.remove(sld)

    # ---------- 표지 ----------
    cover = prs.slides[0]
    for sh in list(cover.shapes):
        if sh.shape_type == 13:                      # PICTURE — 중앙대 로고 제거
            sh._element.getparent().remove(sh._element)
        elif sh.has_text_frame and sh.text_frame.text.strip():
            sh._element.getparent().remove(sh._element)
        elif sh.name.startswith("직선"):
            # 템플릿의 밑줄은 한 줄짜리 제목 기준이라 여러 줄 제목을 관통한다.
            # 제목 아래로 내리고 폭도 제목에 맞춘다.
            sh.left, sh.top, sh.width = inch(2.60), inch(3.42), inch(8.13)

    _, tf = textbox(cover, 0.90, 1.62, 11.53, 1.9)
    for i, ln in enumerate(TITLE_EN.split("\n")):
        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
        p.alignment = PP_ALIGN.CENTER
        p.line_spacing = 1.18
        run(p, ln, size=27, bold=True)

    _, tf = textbox(cover, 1.20, 3.70, 10.93, 0.6)
    p = tf.paragraphs[0]
    p.alignment = PP_ALIGN.CENTER
    run(p, TITLE_KO, size=13, color=GREY)

    _, tf = textbox(cover, 1.20, 4.72, 10.93, 2.0)
    meta = [("2026 International Conference on PyGeek", 15, True, INK),
            ("August 20, 2026  ·  Hongik University, Seoul", 14, False, DIM),
            ("", 8, False, DIM),
            ("Junha Yoon · Ohhyeon Gwon · Junhaeng Lee · Hyeji Roh · "
             "Soowan Cho · Suhee Kim · SangSoon Lim", 13, True, INK),
            ("Sungkyul University · Chung-Ang University · Deep Insight Lab", 12, False, GREY)]
    for i, (txt, sz, bd, col) in enumerate(meta):
        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
        p.alignment = PP_ALIGN.CENTER
        run(p, txt, size=sz, bold=bd, color=col, space_after=7)

    # ---------- 내용 슬라이드 ----------
    for idx, spec in enumerate(SLIDES, start=2):
        s = prs.slides.add_slide(blank_layout)
        for ph in list(s.placeholders):
            ph._element.getparent().remove(ph._element)
        for el in deco_xml:
            s.shapes._spTree.append(deepcopy(el))
        # 페이지 번호 갱신
        for sh in s.shapes:
            if sh.has_text_frame and sh.text_frame.text.strip() == "2":
                sh.text_frame.paragraphs[0].runs[0].text = str(idx)

        # 제목
        _, tf = textbox(s, BODY_L - 0.04, 0.30, BODY_W, 0.55)
        tf.vertical_anchor = MSO_ANCHOR.MIDDLE
        run(tf.paragraphs[0], spec["title"], size=24, bold=True)

        # 한국어 리드 — 슬라이드는 영문이지만 발표는 한국어로 한다.
        # 이 한 줄만 보고도 무슨 말을 할지 떠오르게 하는 것이 목적이다.
        top = BODY_T
        if spec.get("lead"):
            _, tf = textbox(s, BODY_L, 0.94, BODY_W, 0.36)
            run(tf.paragraphs[0], spec["lead"], size=15, bold=True, color=DIM)
            top = 1.50

        layout(s, spec, top)

    prs.save(str(OUT))
    print(f"저장: {OUT.name}  ({len(prs.slides.__iter__.__self__._sldIdLst)}장)")


def est_body_height(blocks, size):
    """본문이 차지할 높이를 인치로 어림한다.

    정확할 필요는 없다. 내용을 안전 영역 안에 앉히고 위아래 여백을 고르게
    나누는 것이 목적이라, 실제보다 조금 넉넉하게 잡는 편이 안전하다.
    """
    from math import ceil
    # 라틴 문자는 폭이 글자크기의 0.55 배쯤이라 같은 상자에 두 배 가까이 들어간다.
    # 한글 기준(≈1.0)으로 잡으면 여유가 있는데도 넘친다고 보고 글자를 줄여 버린다.
    per_line = BODY_W * 72 / (size * 0.56)
    pts = 0.0
    for kind, text in blocks:
        if kind == "s":
            pts += size * 0.55
        elif kind == "h":
            pts += (size + 1) * 1.35 + 7
        elif kind == "n":
            pts += (size - 3) * 1.35 + 5
        elif kind == "q":
            pts += (size + 3) * 1.35 * max(1, ceil(len(text) / per_line)) + 10
        else:
            pts += size * 1.32 * max(1, ceil(len(text) / per_line)) + 4
    return pts / 72 * 1.08          # 줄바꿈 지점을 정확히 못 맞추므로 8% 여유


def layout(slide, spec):
    """표·카드·그림·본문을 쌓고, 전체 덩어리를 안전 영역 세로 중앙에 앉힌다."""
    body = spec.get("body")
    GAP = 0.30

    fixed = 0.0                                  # 그림을 뺀 고정 요소 높이
    if "table" in spec:
        fixed += 0.36 * (len(spec["table"]["rows"]) + 1) + GAP
    if "stats" in spec:
        fixed += 1.42 + GAP

    # 본문 글자 크기 — 다 들어갈 때까지 한 단계씩 줄인다
    size, bh = 17, 0.0
    if body:
        for size in (17, 16, 15, 14):
            bh = est_body_height(body, size)
            if fixed + bh <= BODY_H:
                break

    if "image" in spec:
        from PIL import Image
        png = FIGDIR / spec["image"]
        iw, ih = Image.open(png).size
        avail = BODY_H - fixed - (bh + 0.24 if body else 0)
        w = BODY_W
        h = w * ih / iw
        if h > avail:
            h = avail
            w = h * iw / ih
        total = fixed + h + (bh + 0.24 if body else 0)
    else:
        total = fixed + bh

    y = BODY_T + max(0.0, (BODY_H - total) / 2)

    if "table" in spec:
        y = draw_table(slide, spec["table"], y) + GAP
    if "stats" in spec:
        y = draw_stats(slide, spec["stats"], y) + GAP
    if "image" in spec:
        slide.shapes.add_picture(str(png), inch(BODY_L + (BODY_W - w) / 2),
                                 inch(y), inch(w), inch(h))
        y += h + 0.24
    if body:
        draw_body(slide, body, y, min(bh + 0.25, BODY_B - y), size=size)


def draw_body(slide, blocks, top, height, size=16):
    _, tf = textbox(slide, BODY_L, top, BODY_W, height)
    first = True
    for kind, text in blocks:
        p = tf.paragraphs[0] if first else tf.add_paragraph()
        first = False
        p.line_spacing = 1.28
        if kind == "s":
            p.space_after = Pt(2)
            run(p, "", size=6)
        elif kind == "h":
            run(p, text, size=size + 1, bold=True, color=BLUE, space_before=4, space_after=3)
        elif kind == "b":
            # 두 줄 이상으로 넘어가는 항목의 둘째 줄이 글머리 아래로 파고들지 않도록
            # 내어쓰기를 준다.
            pPr = p._p.get_or_add_pPr()
            pPr.set("marL", str(int(0.30 * 914400)))
            pPr.set("indent", str(int(-0.30 * 914400)))
            run(p, "·  ", size=size, bold=True, color=GREY)
            run(p, text, size=size)
            p.space_after = Pt(4)
        elif kind == "q":
            run(p, text, size=size + 3, bold=True, color=INK, space_before=6, space_after=4)
        elif kind == "n":
            run(p, text, size=size - 3, color=GREY, space_before=5)
    return tf


def draw_stats(slide, stats, top):
    """큰 숫자 카드 3개를 가로로."""
    gap, n = 0.26, len(stats)
    w = (BODY_W - gap * (n - 1)) / n
    h = 1.42
    for i, (label, value, sub) in enumerate(stats):
        x = BODY_L + i * (w + gap)
        box = slide.shapes.add_shape(1, inch(x), inch(top), inch(w), inch(h))
        box.fill.solid()
        box.fill.fore_color.rgb = FILL
        box.line.color.rgb = RGBColor(0xD5, 0xD5, 0xD5)
        box.line.width = Pt(1)
        box.shadow.inherit = False
        tf = box.text_frame
        tf.word_wrap = True
        tf.margin_left = tf.margin_right = inch(0.14)
        tf.margin_top = inch(0.13)
        tf.margin_bottom = inch(0.10)
        p = tf.paragraphs[0]
        p.alignment = PP_ALIGN.LEFT          # 도형 기본값(가운데)이면 숫자와 어긋난다
        run(p, label, size=13, bold=True, color=GREY)
        p = tf.add_paragraph()
        p.alignment = PP_ALIGN.LEFT
        run(p, value, size=27, bold=True, color=INK, space_before=2)
        p = tf.add_paragraph()
        p.alignment = PP_ALIGN.LEFT
        run(p, sub, size=12, color=DIM, space_before=2)
    return top + h


def draw_table(slide, spec, top):
    rows, cols = len(spec["rows"]) + 1, len(spec["header"])
    h = 0.36 * rows
    shape = slide.shapes.add_table(rows, cols, inch(BODY_L), inch(top), inch(BODY_W), inch(h))
    tbl = shape.table
    tbl.columns[0].width = inch(1.85)
    for c in range(1, cols):
        tbl.columns[c].width = inch((BODY_W - 1.85) / (cols - 1))
    data = [spec["header"]] + spec["rows"]
    for r, rowvals in enumerate(data):
        tbl.rows[r].height = inch(0.36)
        for c, val in enumerate(rowvals):
            cell = tbl.cell(r, c)
            cell.margin_left = cell.margin_right = inch(0.10)
            cell.margin_top = cell.margin_bottom = inch(0.04)
            cell.vertical_anchor = MSO_ANCHOR.MIDDLE
            tf = cell.text_frame
            tf.word_wrap = True
            p = tf.paragraphs[0]
            p.alignment = PP_ALIGN.LEFT if c == 0 else PP_ALIGN.CENTER
            run(p, val, size=14, bold=(r == 0 or c == 0),
                color=INK if r == 0 else (GREY if c == 0 else INK))
    return top + h


def draw_image(slide, png, top, body):
    """그림을 폭에 맞춰 넣고, 남는 아래 공간에 설명을 붙인다."""
    from PIL import Image
    iw, ih = Image.open(png).size
    # 설명이 있으면 그만큼 아래를 비워 둔다
    reserve = 0.0
    if body:
        reserve = 0.30 + 0.34 * len([b for b in body if b[0] in ("b", "n", "q")])
    avail_h = BODY_B - top - reserve
    w = BODY_W
    h = w * ih / iw
    if h > avail_h:
        h = avail_h
        w = h * iw / ih
    x = BODY_L + (BODY_W - w) / 2
    slide.shapes.add_picture(str(png), inch(x), inch(top), inch(w), inch(h))
    if body:
        draw_body(slide, body, top + h + 0.20, BODY_B - (top + h + 0.20), size=15)
    return top + h


if __name__ == "__main__":
    build()
