"""PyGeek 2026 구두발표 슬라이드 생성 (한국어).

발표: 2026-08-20(목) 14:10~14:30 · Oral Presentation #1 · 홍익대
20분에 질의응답이 포함되므로 발표는 15분 안쪽. 슬라이드 13장.

INC Lab 주간보고 템플릿(`docs/reference/template.pptx`)의 서식을 물려받는다.
템플릿의 장식 도형(배경·좌상단 파란 사각형·하단 회색바·페이지번호 박스)을
그대로 복제하고 본문만 새로 얹는다. 레이아웃 placeholder 를 쓰지 않는 이유는
템플릿 자체가 placeholder 없이 TextBox 로만 구성돼 있기 때문이다.

중앙대 로고는 넣지 않는다 — 저자 소속이 3개 기관이라 한 곳의 로고만 넣는 것은
맞지 않는다.

⚠️ 산학 비밀유지: 서비스 실명(DILAB·딥인사이트랩)을 쓰지 않는다.
   논문과 같은 익명 서술(`국내 제품 리뷰 분석 서비스`)만 사용한다.
   발표자료는 Proceedings 수록 예정이므로 공개물 전제로 작성한다.
"""

from copy import deepcopy
from pathlib import Path

from pptx import Presentation
from pptx.dml.color import RGBColor
from pptx.enum.text import MSO_ANCHOR, PP_ALIGN
from pptx.util import Cm, Emu, Pt

ROOT = Path(__file__).resolve().parents[3]
TEMPLATE = ROOT / "docs/reference/template.pptx"
FIGDIR = ROOT / "docs/figures"
OUT = Path(__file__).resolve().parent / "PyGeek2026_발표_윤준하.pptx"

FONT = "맑은 고딕"
INK = RGBColor(0x00, 0x00, 0x00)
BLUE = RGBColor(0x33, 0x75, 0xBE)
GREY = RGBColor(0x82, 0x7E, 0x7F)
RED = RGBColor(0xF9, 0x41, 0x45)
DIM = RGBColor(0x5A, 0x5A, 0x5A)
FILL = RGBColor(0xF1, 0xF1, 0xF1)

# 본문 안전 영역 — 템플릿 실측 (제목 0.32", 하단 회색바 7.08")
BODY_L, BODY_T, BODY_W = 0.78, 1.15, 11.29
BODY_B = 6.85                      # 회색바(7.08")에서 0.23" 띄운다
BODY_H = BODY_B - BODY_T


def inch(v):
    return Emu(int(v * 914400))


# ==========================================================================
# 슬라이드 내용
# ==========================================================================
